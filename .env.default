# Copy this file to `.env` and fill in the key for the LLM provider you use.
# coach loads `.env` automatically at startup. The variable name here must
# match the `api_key_env` set in your coach.toml. `.env` is gitignored, so
# your real key never gets committed.

# OpenAI
OPENAI_API_KEY=

# Claude (via Anthropic's OpenAI-compatible endpoint)
ANTHROPIC_API_KEY=
